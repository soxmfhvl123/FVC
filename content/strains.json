      "coverStyle": "golova | creatura | glitch | connwax — which cover template",
      "eyes": "two | cyclops | three | none",
      "spot": "one spot ink hex from tokens",
      "sideA/sideB": "tracks; side = \"A\" | \"B\"; incubation = duration m:ss (ffprobe); spread = 1-5 or null; audio = path under apps/web/public or null; mutationOf = source track on the other side (e.g. \"A1\")",
      "vinyl": "Pressing Plant params when a vinyl exists",
      "status": "draft | scheduled | live | dormant",
      "sides": "optional side names, e.g. {\"A\": \"STRAIN\", \"B\": \"MUTATION\"}",
      "tracks.seed/phase/hidden/label": "optional per track: seed = germ drawn instead of a title; phase = \"FEVER\" | \"DORMANT\"; hidden = shown as #???? until played; label = name revealed with it (e.g. SPECIMEN)"
    }
  },
