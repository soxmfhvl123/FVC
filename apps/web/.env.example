# Copy to .env.local. Everything is optional. The site is a static export (GitHub Pages).

# Hide strains/outbreaks with status "draft" (docs/06 Q1). Default: drafts are shown.
FVC_HIDE_DRAFTS=false

# Hosted form endpoints (e.g. Formspree) — the browser POSTs JSON straight to them.
# On GitHub, set these as repository Variables; without them the forms say "opens soon".
NEXT_PUBLIC_SUBMIT_ENDPOINT=
NEXT_PUBLIC_SPREAD_ENDPOINT=
