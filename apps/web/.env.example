# Copy to .env.local. Everything is optional.

# Hide strains/outbreaks with status "draft" (docs/06 Q1). Default: drafts are shown.
FVC_HIDE_DRAFTS=false

# Sample Submission email via Resend (docs/06 Q4). Without these, /submit refuses politely in production.
RESEND_API_KEY=
SUBMISSIONS_TO=
SUBMISSIONS_FROM="FVC Sample Submission <samples@fvc.ai.kr>"

# Spread Report signups are POSTed here as {email, source} (docs/06 Q5). Any provider/automation webhook.
NEWSLETTER_WEBHOOK_URL=

# Serve /dev/components in production (component sheet). Default: 404.
FVC_DEV_PAGES=false
