{
  "$schema": "fvc-tokens/1",
  "color": {
    "paper":    { "value": "#E8E7E3", "use": "page ground" },
    "grey":     { "value": "#D4D3CF", "use": "hero, posters, lens (Golova grey)" },
    "greyDark": { "value": "#CFCECA", "use": "cover grounds, stripe banners" },
    "white":    { "value": "#F7F7F5", "use": "photocopy pieces, labels, inputs" },
    "ink":      { "value": "#0B0B0B", "use": "bitmap, bars, type, rules" },
    "spot":     { "value": "#FF5B47", "use": "FVC Coral — the house spot ink (one per piece)" },
    "acid":     { "value": "#A6FF00", "use": "outbreak colour — banners, Colony, CTA" },
    "magenta":  { "value": "#FF2DB4", "use": "outbreak colour — banners, Mutator" },
    "red":      { "value": "#FF2A1A", "use": "outbreak colour — banner 1" },
    "cobalt":   { "value": "#2B44FF", "use": "outbreak colour / alternate spot" },
    "yellow":   { "value": "#FFE800", "use": "melt letters, riso palette" },
    "orange":   { "value": "#FF6C2F", "use": "meter peak, riso palette" }
  },
  "font": {
    "info":    { "family": "Inter Tight", "weights": [400, 500, 600, 800], "use": "corner/edge info, body, UI" },
    "display": { "family": "Archivo", "axes": { "wdth": [62, 125], "wght": [400, 900] }, "use": "900 at 62% (condensed headlines) or 125% (wide bars, numbers)" },
    "goth":    { "family": "Grenze Gotisch", "weights": [800, 900], "use": "one flavour word per line" },
    "serif":   { "family": "Instrument Serif", "style": "italic", "use": "asides" },
    "mono":    { "family": "DM Mono", "weights": [400, 500], "use": "data: incubation, spread, codes" }
  },
  "rule": { "thin": "1px", "base": "2px", "heavy": "3px" },
  "radius": { "none": "0", "pill": "999px", "tag": "6px", "icon": "34px" },
  "motion": { "wordmarkTickMs": 900, "bannerTickMs": 1000, "tapeLoopS": 34, "respectReducedMotion": true },
  "grain": { "opacity": [0.12, 0.22], "blend": "multiply", "filter": "feTurbulence fractalNoise 0.85 / 3 octaves" }
}
